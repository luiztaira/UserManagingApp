<Window x:Class="UserManagingApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ユーザー管理" 
        Height="600" Width="800"
        Icon="/Assets/Icons/ManageCounterSets.ico"
        SizeToContent="Manual"
        ResizeMode="CanResizeWithGrip"
        MinWidth="600"
        MinHeight="450"
        WindowStartupLocation="CenterOwner">

    <Window.Resources>
        <Style TargetType="ListBoxItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Padding" Value="0,5"/>
        </Style>
    </Window.Resources>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <!-- Search Box -->
            <RowDefinition Height="Auto"/>

            <!-- Advanced Filters -->
            <RowDefinition Height="Auto"/>

            <!-- Column Headers -->
            <RowDefinition Height="Auto"/>

            <!-- User List -->
            <RowDefinition Height="*"/>

            <!-- Buttons -->
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Search Box -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" VerticalAlignment="Center">
            <Grid Width="300" Height="30">
                <TextBox x:Name="SearchTextBox"
                         VerticalContentAlignment="Center"
                         Padding="25,0,5,0"
                         KeyDown="SearchTextBox_KeyDown"/>

                <Image Source="/Assets/Images/Search.png"
                       Width="16"
                       Height="16"
                       HorizontalAlignment="Left"
                       VerticalAlignment="Center"
                       Margin="5,0,0,0"
                       IsHitTestVisible="False"/>

                <TextBlock x:Name="PlaceholderTextBlock"
                           Text="フィルターを選択し、検索してください。"
                           Foreground="Gray"
                           VerticalAlignment="Center"
                           Margin="25,0,5,0"
                           IsHitTestVisible="False"/>
            </Grid>

            <Button x:Name="SearchButton" 
                    Content="検索" 
                    Width="80" 
                    Margin="10,0,0,0" 
                    Click="SearchButton_Click"
                    IsEnabled="False"
                    ToolTip="フィルターを選択してください" />

            <Button x:Name="ResetButton"
                    Content="リセット"
                    Width="80"
                    Margin="10,0,0,0"
                    Click="ResetFilters_Click" />
        </StackPanel>

        <!-- Advanced Filters -->
        <Expander Grid.Row="1" Header="フィルター" Margin="0,10" IsExpanded="True">
            <StackPanel>
                <!-- Checkbox Row -->
                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                    <CheckBox x:Name="NameFilterCheckBox"
                      Content="名前"
                      Margin="0,0,10,0"
                      IsChecked="False"
                      Checked="FilterCheckBox_Changed"
                      Unchecked="FilterCheckBox_Changed"/>
                    <CheckBox x:Name="EmailFilterCheckBox" 
                      Content="メールアドレス"
                      Margin="0,0,10,0"
                      IsChecked="False"
                      Checked="FilterCheckBox_Changed"
                      Unchecked="FilterCheckBox_Changed"/>
                    <CheckBox x:Name="PhoneNumberFilterCheckBox"
                      Content="電話番号"
                      Margin="0,0,10,0"
                      IsChecked="False"
                      Checked="FilterCheckBox_Changed"
                      Unchecked="FilterCheckBox_Changed"  
/>
                </StackPanel>

                <!-- Date Picker Row -->
                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                    <CheckBox x:Name="DateFilterCheckBox"
                      Content="作成日"
                      Margin="0,0,10,0"
                      IsChecked="False"
                      Checked="FilterCheckBox_Changed"
                      Unchecked="FilterCheckBox_Changed"/>
                    <DatePicker x:Name="FromDatePicker" Width="110" Language="ja-Jp">
                        <DatePicker.Resources>
                            <Style TargetType="DatePickerTextBox">
                                <Setter Property="Text" Value="日付を選択"/>
                            </Style>
                        </DatePicker.Resources>
                    </DatePicker>
                    <TextBlock Text="から" VerticalAlignment="Center" Margin="10,0"/>
                    <DatePicker x:Name="ToDatePicker" Width="110" Language="ja-Jp">
                        <DatePicker.Resources>
                            <Style TargetType="DatePickerTextBox">
                                <Setter Property="Text" Value="日付を選択"/>
                            </Style>
                        </DatePicker.Resources>
                    </DatePicker>
                    <TextBlock Text="まで" VerticalAlignment="Center" Margin="10,0"/>
                </StackPanel>

                <!-- Privileges Row -->
                <StackPanel Orientation="Horizontal">
                    <CheckBox x:Name="PrivilegesFilterCheckBox"
                      Content="権限"
                      Margin="0,0,10,0"
                      IsChecked="False"
                      Checked="FilterCheckBox_Changed"
                      Unchecked="FilterCheckBox_Changed"/>
                    <ComboBox x:Name="PrivilegesCombo"
                      Width="120"
                      DisplayMemberPath="Value" 
                      SelectedValuePath="Key"/>
                </StackPanel>
            </StackPanel>
        </Expander>

        <!-- Column Headers -->
        <Border Grid.Row="2" Background="#F0F0F0" Padding="5" Margin="0,10,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.5*" MinWidth="150"/>
                    <ColumnDefinition Width="2*" MinWidth="200"/>
                    <ColumnDefinition Width="1*" MinWidth="120"/>
                    <ColumnDefinition Width="1*" MinWidth="120"/>
                    <ColumnDefinition Width="1.5*" MinWidth="150"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="名前" FontWeight="Bold"/>
                <TextBlock Text="メールアドレス" Grid.Column="1" FontWeight="Bold"/>
                <TextBlock Text="電話番号" Grid.Column="2" FontWeight="Bold"/>
                <TextBlock Text="権限" Grid.Column="3" FontWeight="Bold"/>
                <TextBlock Text="作成日" Grid.Column="4" FontWeight="Bold"/>
            </Grid>
        </Border>

        <!-- User List -->
        <ListBox x:Name="UserListBox" 
                 Grid.Row="3" 
                 Margin="0,5,0,0"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 ScrollViewer.VerticalScrollBarVisibility="Auto">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.5*" MinWidth="150"/>
                            <ColumnDefinition Width="2*" MinWidth="200"/>
                            <ColumnDefinition Width="1*" MinWidth="120"/>
                            <ColumnDefinition Width="1*" MinWidth="120"/>
                            <ColumnDefinition Width="1.5*" MinWidth="150"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="{Binding Name}" 
                                   TextTrimming="CharacterEllipsis"
                                   Margin="5,0"/>
                        <TextBlock Text="{Binding Email}" 
                                   Grid.Column="1"
                                   TextTrimming="CharacterEllipsis"
                                   Margin="5,0"/>
                        <TextBlock Text="{Binding PhoneNumber}" 
                                   Grid.Column="2"
                                   Margin="5,0"/>
                        <TextBlock Text="{Binding Privileges}" 
                                   Grid.Column="3"
                                   Margin="5,0"/>
                        <TextBlock Text="{Binding CreatedAt, StringFormat={}{0:yyyy-MM-dd}}" 
                                   Grid.Column="4"
                                   Margin="5,0"/>
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <!-- Action Buttons -->
        <Grid Grid.Row="4" Margin="0,10,0,0">
            <Button x:Name="AddUserButton"
                    Width="110"
                    HorizontalAlignment="Left"
                    Click="AddUserButton_Click">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <Image Source="/Assets/Images/AddUser.png"
                           Width="16"
                           Height="16"
                           Margin="0,0,5,0"/>
                    <TextBlock Text="ユーザーを追加" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="EditUserButton"
                        Content="ユーザーを編集"
                        Width="100"
                        Margin="0,0,10,0"
                        Click="EditUser_Click"/>

                <Button x:Name="DeleteUserButton"
                        Content="ユーザーの削除"
                        Width="100"
                        Click="DeleteUser_Click"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>