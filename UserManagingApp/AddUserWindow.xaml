<Window x:Class="UserManagingApp.AddUserWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ユーザーを追加" Height="350" Width="400"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Icon="/Assets/Icons/AddUser.ico">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- Name Label -->
            <RowDefinition Height="Auto"/>
            <!-- Name TextBox -->
            <RowDefinition Height="Auto"/>
            <!-- Email Label -->
            <RowDefinition Height="Auto"/>
            <!-- Email TextBox -->
            <RowDefinition Height="Auto"/>
            <!-- Phone Label -->
            <RowDefinition Height="Auto"/>
            <!-- Phone TextBox -->
            <RowDefinition Height="Auto"/>
            <!-- Privileges Label -->
            <RowDefinition Height="Auto"/>
            <!-- Privileges ComboBox -->
            <RowDefinition Height="*"/>
            <!-- Buttons -->
        </Grid.RowDefinitions>

        <!-- Name -->
        <TextBlock Text="名前：" Grid.Row="0" Margin="0,0,0,5"/>
        <TextBox x:Name="NameTextBox" Grid.Row="1" Margin="0,0,0,10"/>

        <!-- Email -->
        <TextBlock Text="メールアドレス：" Grid.Row="2" Margin="0,0,0,5"/>
        <TextBox x:Name="EmailTextBox" Grid.Row="3" Margin="0,0,0,10"/>

        <!-- Phone Number -->
        <TextBlock Text="電話番号：" Grid.Row="4" Margin="0,0,0,5"/>
        <TextBox x:Name="PhoneNumberTextBox" Grid.Row="5" Margin="0,0,0,10"/>

        <!-- Privileges -->
        <TextBlock Text="権限：" Grid.Row="6" Margin="0,10,0,5"/>
        <ComboBox x:Name="PrivilegesComboBox" Grid.Row="7" Margin="0,0,0,20">
        </ComboBox>

        <!-- Buttons -->
        <StackPanel Grid.Row="8" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="追加" Width="80" Click="SaveButton_Click" IsDefault="True" Margin="0,0,10,0" />
            <Button Content="キャンセル" Width="80" IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>