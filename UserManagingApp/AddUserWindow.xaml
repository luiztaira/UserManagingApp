<Window
    x:Class="UserManagingApp.AddUserWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="ユーザーを追加"
    Width="400"
    Height="350"
    Icon="/Assets/Icons/AddUser.ico"
    ResizeMode="NoResize"
    WindowStartupLocation="CenterOwner">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <!--  Name Label  -->
            <RowDefinition Height="Auto" />
            <!--  Name TextBox  -->
            <RowDefinition Height="Auto" />
            <!--  Email Label  -->
            <RowDefinition Height="Auto" />
            <!--  Email TextBox  -->
            <RowDefinition Height="Auto" />
            <!--  Phone Label  -->
            <RowDefinition Height="Auto" />
            <!--  Phone TextBox  -->
            <RowDefinition Height="Auto" />
            <!--  Privileges Label  -->
            <RowDefinition Height="Auto" />
            <!--  Privileges ComboBox  -->
            <RowDefinition Height="*" />
            <!--  Buttons  -->
        </Grid.RowDefinitions>

        <!--  Name  -->
        <TextBlock
            Grid.Row="0"
            Margin="0,0,0,5"
            Text="名前：" />
        <TextBox
            x:Name="NameTextBox"
            Grid.Row="1"
            Margin="0,0,0,10" />

        <!--  Email  -->
        <TextBlock
            Grid.Row="2"
            Margin="0,0,0,5"
            Text="メールアドレス：" />
        <TextBox
            x:Name="EmailTextBox"
            Grid.Row="3"
            Margin="0,0,0,10" />

        <!--  Phone Number  -->
        <TextBlock
            Grid.Row="4"
            Margin="0,0,0,5"
            Text="電話番号：" />
        <TextBox
            x:Name="PhoneNumberTextBox"
            Grid.Row="5"
            Margin="0,0,0,10" />

        <!--  Privileges  -->
        <TextBlock
            Grid.Row="6"
            Margin="0,10,0,5"
            Text="権限：" />
        <ComboBox
            x:Name="PrivilegesComboBox"
            Grid.Row="7"
            Margin="0,0,0,20" />

        <!--  Buttons  -->
        <StackPanel
            Grid.Row="8"
            HorizontalAlignment="Right"
            Orientation="Horizontal">
            <Button
                Width="80"
                Margin="0,0,10,0"
                Click="SaveButton_Click"
                Content="追加"
                IsDefault="True" />
            <Button
                Width="80"
                Content="キャンセル"
                IsCancel="True" />
        </StackPanel>
    </Grid>
</Window>